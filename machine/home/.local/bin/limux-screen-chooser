#!/usr/bin/env python3
"""Limux screen-share chooser for xdg-desktop-portal-wlr (chooser_type = dmenu).
The Limux picker lists what can be shared by name; the portal's own line for the
choice is printed back unchanged. Escape cancels the share."""
from html import escape
import re
import subprocess
import sys


def label(line):
    kind, _, name = line.partition(': ')
    if not name:
        kind, name = 'Monitor', line
    if kind == 'Monitor':
        # The portal gives the connector, then the make and model; people know the model.
        connector, _, model = name.partition(' ')
        if connector.startswith('eDP'):
            return 'Built-in display', 'Screen'
        return (model.strip() or f'Display {connector}'), 'Screen'
    # Window lines end with the portal's handle in brackets; the title alone is the name.
    return re.sub(r'\s*\([0-9a-f]{16,}\)$', '', name), 'Window'


lines = [line.rstrip('\n') for line in sys.stdin if line.strip()]
if not lines:
    sys.exit(1)
rows = [f'{escape(title)}\t<span fgalpha="75%">{escape(detail)}</span>' for title, detail in map(label, lines)]
result = subprocess.run(['rofi', '-dmenu', '-i', '-no-custom', '-markup-rows', '-format', 'i', '-p', '',
                         '-theme-str', 'entry { placeholder: "Share your screen"; }'],
                        input='\n'.join(rows) + '\n', text=True, capture_output=True)
if result.returncode != 0 or not result.stdout.strip():
    sys.exit(1)
print(lines[int(result.stdout.strip())])
