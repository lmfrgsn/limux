#!/usr/bin/env python3
"""Limux clipboard history: cliphist behind the Limux picker.

  watch  record text and image copies (run once per session from MangoWM)
  pick   show recent copies in the Limux picker; Enter copies the choice back
  clear  forget the whole history

History lives in memory ($XDG_RUNTIME_DIR), keeps the 50 most recent copies and is
gone at logout. Copies a password manager marks as sensitive are never stored.
"""
from html import escape
import os
from pathlib import Path
import re
import subprocess
import sys

DB = Path(os.environ.get('XDG_RUNTIME_DIR', '/tmp'))/'limux/clipboard.db'
MAX_ITEMS = 50
CLIPHIST = ['cliphist', '-db-path', str(DB), '-max-items', str(MAX_ITEMS)]
PREVIEW = 80
IMAGE = re.compile(r'\[\[ binary data (?P<size>[\d.]+ \w+) (?P<kind>\w+) (?P<width>\d+)x(?P<height>\d+) \]\]')
LINK = re.compile(r'^(https?://|www\.)\S+$')


def watch():
    DB.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    store = CLIPHIST + ['store']
    watchers = [subprocess.Popen(['wl-paste', '--type', kind, '--watch', *store]) for kind in ('text', 'image')]
    for watcher in watchers:
        watcher.wait()


def row(preview):
    """(name, kind) for one history entry as the picker shows it."""
    image = IMAGE.fullmatch(preview.strip())
    if image:
        return f'{image["kind"].upper()}, {image["width"]} × {image["height"]}', 'Image'
    text = ' '.join(preview.split())
    if len(text) > PREVIEW:
        text = text[:PREVIEW - 1].rstrip() + '…'
    return text, 'Link' if LINK.match(text) else 'Text'


def notify(summary):
    subprocess.run(['notify-send', '--app-name=Clipboard', summary], check=False)


def pick():
    listed = subprocess.run(CLIPHIST + ['list'], capture_output=True, text=True) if DB.exists() else None
    entries = [line for line in (listed.stdout.splitlines() if listed and listed.returncode == 0 else [])
               if '\t' in line]
    if not entries:
        notify('Clipboard history is empty')
        return
    rows = [f'{escape(name)}\t<span fgalpha="75%">{escape(kind)}</span>'
            for name, kind in (row(entry.split('\t', 1)[1]) for entry in entries)]
    chosen = subprocess.run(['rofi', '-dmenu', '-i', '-no-custom', '-markup-rows', '-format', 'i', '-p', '',
                             '-theme-str', 'entry { placeholder: "Search clipboard"; }'],
                            input='\n'.join(rows) + '\n', text=True, capture_output=True)
    if chosen.returncode != 0 or not chosen.stdout.strip():
        return  # Escape
    data = subprocess.run(CLIPHIST + ['decode'], input=entries[int(chosen.stdout.strip())].encode(),
                          capture_output=True, check=True).stdout
    subprocess.run(['wl-copy'], input=data, check=True)


def clear():
    if DB.exists():
        subprocess.run(CLIPHIST + ['wipe'], check=True)
    notify('Clipboard history cleared')


if __name__ == '__main__':
    action = sys.argv[1] if len(sys.argv) > 1 else ''
    if action not in ('watch', 'pick', 'clear'):
        raise SystemExit('usage: limux-clipboard watch|pick|clear')
    {'watch': watch, 'pick': pick, 'clear': clear}[action]()
