+// Limux: "glyph-scale" glyphs come from the same font pattern at k times the
+// size of the font being measured or drawn: the logical font for layout, the
+// per-output scaled font for drawing.
+static struct {
+  const struct fcft_font *base;
+  double k;
+  struct fcft_font *font;
+} g_glyph_fonts[32];
+static int g_glyph_font_count;
+
+static struct fcft_font *glyph_font(struct fcft_font *f, uint32_t cp) {
+  double k = 0;
+  for (int i = 0; i < g_cfg.glyph_count; i++)
+    if (g_cfg.glyph_cp[i] == cp)
+      k = g_cfg.glyph_k[i];
+  if (k <= 0)
+    return f;
+  for (int i = 0; i < g_glyph_font_count; i++)
+    if (g_glyph_fonts[i].base == f && g_glyph_fonts[i].k == k)
+      return g_glyph_fonts[i].font;
+  const char *sp = strstr(g_font_base, ":size=");
+  if (!sp || g_glyph_font_count >= 32)
+    return f;
+  int px = 0;
+  if (f == font)
+    px = atoi(sp + 6);
+  for (int s = 1; s < 8 && !px; s++)
+    if (g_scaled_fonts[s] == f)
+      px = atoi(sp + 6) * s;
+  if (px <= 0)
+    return f;
+  char buf[256];
+  snprintf(buf, sizeof(buf), "%.*s:size=%.2f", (int)(sp - g_font_base),
+           g_font_base, px * k);
+  struct fcft_font *nf = fcft_from_name(1, (const char *[]){buf}, NULL);
+  g_glyph_fonts[g_glyph_font_count++] =
+      (typeof(g_glyph_fonts[0])){f, k, nf ? nf : f};
+  return nf ? nf : f;
+}
