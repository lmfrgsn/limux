+// Limux: while g_text_spin is set, draw_text rotates each glyph clockwise by
+// g_text_angle radians about its own centre; layout and advance are unchanged.
+static bool g_text_spin;
+static double g_text_angle;
+#define SPIN_FRAME_MS 66 // about 15 frames per second
+static uint64_t last_spin_ms;
+static uint64_t now_ms(void);
+
+// The current animation frame; the rotation angle for a period follows from it.
+static uint64_t spin_frame(void) { return now_ms() / SPIN_FRAME_MS; }
+
+static double spin_angle(int period) {
+  return 2 * M_PI * (double)(spin_frame() * SPIN_FRAME_MS % (uint64_t)period) / period;
+}
+
+// Composite glyph g as if placed at (gx, gy), rotated by g_text_angle. The
+// rotated glyph fits in a centred square of side s (the glyph box diagonal).
+static void composite_spun_glyph(const struct fcft_glyph *g, pixman_image_t *mask,
+                                 pixman_image_t *dst, int32_t gx, int32_t gy,
+                                 int32_t s) {
+  pixman_image_t *src = pixman_image_create_bits(
+      pixman_image_get_format(g->pix), g->width, g->height,
+      pixman_image_get_data(g->pix), pixman_image_get_stride(g->pix));
+  if (!src)
+    return;
+  double c = cos(g_text_angle), n = sin(g_text_angle);
+  double cx = g->width / 2.0, cy = g->height / 2.0;
+  // Destination to source: the inverse (counter-clockwise) rotation.
+  pixman_transform_t t = {{
+      {pixman_double_to_fixed(c), pixman_double_to_fixed(n),
+       pixman_double_to_fixed(cx - c * cx - n * cy)},
+      {pixman_double_to_fixed(-n), pixman_double_to_fixed(c),
+       pixman_double_to_fixed(cy + n * cx - c * cy)},
+      {0, 0, pixman_fixed_1}}};
+  pixman_image_set_transform(src, &t);
+  pixman_image_set_filter(src, PIXMAN_FILTER_BILINEAR, NULL, 0);
+  int32_t x0 = gx + (g->width - s) / 2, y0 = gy + (g->height - s) / 2;
+  pixman_image_composite32(PIXMAN_OP_OVER, src, mask, dst, x0 - gx, y0 - gy, 0,
+                           0, x0, y0, s, s);
+  pixman_image_unref(src);
+}
