/* Generated by Limux. Rofi candidate 2, preview only. */
* {
    font: "Inter 12";
    background-color: transparent;
    text-color: #343442;
    border-color: #A8A8B4;
    padding: 0px;
    margin: 0px;
    border: 0px;
    spacing: 0px;
}
window {
    width: 620px;
    location: center;
    anchor: center;
    fullscreen: false;
    background-color: #F8F8FA;
    border: 1px;
    border-color: #A8A8B4;
    border-radius: 3px;
    padding: 16px;
}
mainbox {
    children: [ textbox-heading, box-search, listview, message ];
    orientation: vertical;
    spacing: 10px;
}
textbox-heading {
    content: "APPLICATIONS";
    font: "Inter 10";
    text-color: #666573;
    expand: false;
}
/* Opposing edges and a darker floor suggest a shallow recess, without blur. */
box-search {
    children: [ inputbar ];
    orientation: vertical;
    expand: false;
    background-color: #DADAE3;
    border: 1px 0px 0px 1px;
    border-color: #A8A8B4;
    border-radius: 3px;
}
inputbar {
    children: [ entry ];
    orientation: horizontal;
    expand: false;
    padding: 10px;
    border: 0px 1px 1px 0px;
    border-color: #F8F8FA;
}
entry {
    font: "Inter 14";
    placeholder: "Search applications";
    placeholder-color: #343442;
    text-color: #343442;
    cursor-color: #343442;
    cursor-width: 2px;
    vertical-align: 0.5;
    expand: true;
}
listview {
    lines: 7;
    columns: 1;
    layout: vertical;
    fixed-height: false;
    dynamic: true;
    expand: true;
    scrollbar: false;
    cycle: true;
    spacing: 2px;
}
element {
    children: [ element-icon, element-text ];
    padding: 8px;
    spacing: 10px;
    border: 0px 0px 0px 3px;
    border-color: transparent;
    border-radius: 0px;
    background-color: transparent;
    text-color: #343442;
    cursor: pointer;
}
element normal.normal, element alternate.normal, element normal.active, element alternate.active {
    background-color: transparent;
    text-color: #343442;
}
element selected.normal, element selected.active {
    background-color: #EAE9F0;
    border-color: #E3BE47;
    text-color: #343442;
}
element normal.urgent, element alternate.urgent {
    text-color: #AD4038;
}
element selected.urgent {
    background-color: #AD4038;
    border-color: #AD4038;
    text-color: #F8F8FA;
}
element-icon {
    size: 20px;
    expand: false;
    vertical-align: 0.5;
}
element-text {
    expand: true;
    vertical-align: 0.5;
    text-color: inherit;
    highlight: bold;
}
message {
    expand: false;
    padding: 8px;
}
textbox {
    text-color: #666573;
}
