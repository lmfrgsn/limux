/* Generated by Limux from themes/rhapsody.toml ([rofi]). Limux picker. */
configuration {
    drun-display-format: "{name}	[<span fgalpha='75%'>{generic}</span>]";
    drun-match-fields: "name,generic";
}
* {
    font: "Inter 10";
    background-color: transparent;
    text-color: #343442;
    border-color: #A8A8B4;
    padding: 0px;
    margin: 0px;
    border: 0px;
    spacing: 0px;
}
window {
    width: 640px;
    location: center;
    anchor: center;
    fullscreen: false;
    background-color: #F8F8FA;
    border: 1px;
    border-color: #A8A8B4;
    border-radius: 6px;
    padding: 12px;
}
mainbox {
    children: [ box-search, listview, message ];
    orientation: vertical;
    spacing: 8px;
}
/* The recessed field: canvas floor, metal top/left edge, porcelain lower edge. */
box-search {
    children: [ inputbar ];
    orientation: vertical;
    expand: false;
    background-color: #DADAE3;
    border: 1px 0px 0px 1px;
    border-color: #A8A8B4;
    border-radius: 3px;
}
inputbar {
    children: [ entry ];
    orientation: horizontal;
    expand: false;
    padding: 9px 12px;
    border: 0px 1px 1px 0px;
    border-color: #F8F8FA;
}
entry {
    font: "Inter 11";
    placeholder: "Search applications";
    placeholder-color: #343442;
    text-color: #343442;
    cursor-color: #343442;
    cursor-width: 1px;
    vertical-align: 0.5;
    expand: true;
}
listview {
    lines: 7;
    columns: 1;
    layout: vertical;
    fixed-height: false;
    dynamic: true;
    expand: true;
    scrollbar: false;
    cycle: true;
    spacing: 0px;
}
element {
    children: [ element-text ];
    padding: 8px 12px;
    border-radius: 4px;
    background-color: transparent;
    text-color: #343442;
    cursor: pointer;
}
element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: #343442;
}
element selected.normal {
    background-color: #343442;
    text-color: #F8F8FA;
}
element normal.urgent, element alternate.urgent {
    text-color: #AD4038;
}
element selected.urgent {
    background-color: #AD4038;
    text-color: #F8F8FA;
}
element-text {
    expand: true;
    vertical-align: 0.5;
    text-color: inherit;
    highlight: bold;
    tab-stops: [ 430px ];
}
message {
    expand: false;
    padding: 8px 12px;
}
textbox {
    text-color: #686773;
}
