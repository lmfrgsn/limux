/* Custom Mango launcher. Dimensions are logical pixels, scaled by Wayland. */
* {
    font: "Inter,Adwaita Sans 12";
    background-color: transparent;
    text-color: #e8eaed;
    border-color: #3a3d43;
    margin: 0px;
    padding: 0px;
    border: 0px;
    spacing: 0px;
}

window {
    location: center;
    anchor: center;
    width: 660px;
    fullscreen: false;
    background-color: #202124;
    border: 1px;
    border-color: #3a3d43;
    border-radius: 18px;
    padding: 14px;
}

mainbox {
    children: [ inputbar, listview, message ];
    spacing: 10px;
}

inputbar {
    children: [ icon-search, entry ];
    orientation: horizontal;
    spacing: 16px;
    padding: 12px 14px 20px;
    border: 0px 0px 1px;
    border-color: #303338;
}

icon-search {
    filename: "/home/liam/.config/rofi/assets/search.svg";
    size: 20px;
    expand: false;
    vertical-align: 0.5;
}

entry {
    font: "Inter,Adwaita Sans 18";
    placeholder: "Search applications";
    placeholder-color: #858b94;
    text-color: #eef0f3;
    cursor-color: #a8bbdf;
    cursor-width: 2px;
    vertical-align: 0.5;
    expand: true;
}

listview {
    lines: 7;
    columns: 1;
    layout: vertical;
    fixed-height: true;
    dynamic: false;
    scrollbar: false;
    cycle: true;
    spacing: 4px;
    padding: 4px 0px 0px;
}

element {
    children: [ element-icon, element-text ];
    spacing: 14px;
    padding: 10px 12px;
    border-radius: 9px;
    background-color: transparent;
    text-color: #cdd1d7;
    cursor: pointer;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: #cdd1d7;
}

element normal.active, element alternate.active {
    background-color: transparent;
    text-color: #e8eaed;
}

element selected.normal, element selected.active {
    background-color: #343c49;
    text-color: #f3f5f8;
}

element normal.urgent, element alternate.urgent {
    background-color: transparent;
    text-color: #e8b4b1;
}

element selected.urgent {
    background-color: #43363c;
    text-color: #f3d0ce;
}

element-icon {
    size: 26px;
    expand: false;
    vertical-align: 0.5;
    background-color: transparent;
}

element-text {
    expand: true;
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
    highlight: bold #bacbed;
}

message {
    padding: 8px 14px;
}

textbox {
    font: "Inter,Adwaita Sans 11";
    text-color: #9aa0a6;
}
